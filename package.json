    "serialize-javascript": "7.0.4",
    "@babel/traverse": "7.29.0"
  },
  "optionalDependencies": {
    "ioredis": "5.6.1"
  },
  "typings": "dist/index.d.ts",
  "typescript": {
    "definition": "dist/index.d.ts"
  }
